{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erniekay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  // postgres.js needs node:net / node:tls.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-sensitive MoMo configuration. Credentials and the merchant number are
  // secrets (`wrangler secret put`), not vars — vars in this file are public,
  // and anything set only in the dashboard is wiped on the next deploy.
  //
  // Secrets this Worker needs, none of which belong here:
  //   DATABASE_URL
  //   MTN_MOMO_API_USER
  //   MTN_MOMO_API_KEY
  //   MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY
  //   MTN_MOMO_MERCHANT_NUMBER
  //   MTN_MOMO_CALLBACK_TOKEN   <- the callback endpoint 404s until this is set
  "vars": {
    // MTN_MOMO_BASE_URL is deliberately NOT set. lib/mtnMomo.ts derives the host
    // from MTN_MOMO_TARGET_ENVIRONMENT; pinning it here would send a sandbox
    // environment at the production proxy, which fails as 401 "invalid
    // subscription key" and reads like bad credentials rather than a wrong host.
    // Set it only to override the derivation deliberately.
    "MTN_MOMO_TARGET_ENVIRONMENT": "production",
    // Ignored while TARGET_ENVIRONMENT is "sandbox" — sandbox Collections only
    // accepts EUR, so the code forces it there and honours this value in production.
    "MTN_MOMO_CURRENCY": "GHS",
    // Documentation only — nothing reads this. The URL actually registered with
    // MTN must have "?token=<MTN_MOMO_CALLBACK_TOKEN>" appended. That token is a
    // secret and must never be written into this file, which is committed.
    "MTN_MOMO_CALLBACK_URL": "https://erniekaysplendor.org/api/payments/mtn/callback"
  },
  // Builds the Worker bundle before deploying. Without this, `wrangler deploy`
  // would upload a stale (or missing) .open-next directory.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  // A Worker cannot open a direct TCP connection to Supabase, so Postgres goes
  // through Hyperdrive, which also pools connections on Cloudflare's side.
  //
  // This file must stay committed: `wrangler deploy` replaces the Worker's
  // bindings and plain vars with whatever is here, so anything added only in
  // the dashboard is wiped on the next deploy. Secrets are the exception —
  // DATABASE_URL is a secret and is managed with `wrangler secret put`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8acf0c6c83eb4b05857611c7de97fc53",
      // Placeholder only. Wrangler refuses to load a Hyperdrive binding without
      // one — including during `opennextjs-cloudflare deploy`, which starts a
      // local platform proxy to read bindings. Nothing connects to it while
      // deploying, and production uses the Hyperdrive config above. To actually
      // run the Worker locally against a database, override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE rather than
      // putting real credentials in this file.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ]
}
