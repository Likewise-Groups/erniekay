# @opennextjs/cloudflare declares a peer dependency of next >=16.2.11, but this
# app is on 16.2.7. Cloudflare's build container previously installed the
# adapter with --force during its auto-configuration step, so this only became
# visible once the adapter became a real dependency. `npm clean-install` in CI
# runs with strict peer resolution and fails without this.
legacy-peer-deps=true
